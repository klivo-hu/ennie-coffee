# =============================================================================
# Ennie Coffee — environment
#
# Copy to `.env` and fill in. docker-compose.yml reads it in production; the local and dev stacks
# read it too, with the localhost switches in docker/local.env on top. `npm run dev` reads
# `.env.local` instead.
# Never commit a filled-in copy. Every variable is documented in docs/environment.md.
# =============================================================================

# ----------------------------------------------------------------- application
# Public origin, used for canonical URLs, the sitemap, Open Graph, and structured data.
SITE_URL=https://www.example.hu
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ----------------------------------------------------------------- database
# Compose starts PostgreSQL with these; the app connects with DATABASE_URL.
# Use a long random password (e.g. `openssl rand -base64 32`, without / + =).
POSTGRES_USER=ennie
POSTGRES_PASSWORD=
POSTGRES_DB=ennie
# Inside Compose the host is the service name `db`.
DATABASE_URL=postgresql://ennie:CHANGE_ME@db:5432/ennie
# Connections per application instance.
DATABASE_POOL_MAX=10

# ----------------------------------------------------------------- authentication
# HS256 signing secret for 10-minute access tokens. At least 32 random characters:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ISSUER=ennie-coffee
JWT_AUDIENCE=ennie-coffee-admin
# Encrypts TOTP (two-factor) secrets at rest. At least 32 random characters, different from above.
APP_ENCRYPTION_KEY=
# Require two-factor sign-in for every admin (default: true in production).
ADMIN_MFA_REQUIRED=true
# Secure cookies. Only set to false for plain-HTTP local development.
AUTH_COOKIE_SECURE=true

# First administrator, created on first start when no admin exists. Username: 3–64 characters
# (letters, digits, . _ -); password: 12+ characters. Ignored once an admin exists — the password
# can then be removed from this file and changed in the admin.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ----------------------------------------------------------------- proxies & scaling
# Reverse proxies in front of the app. Klivo platform with the bundled balancer:
# Traefik + HAProxy = 2. Local compose (HAProxy only) = 1. `npm run dev` = 0.
TRUSTED_PROXY_HOPS=2

# ----------------------------------------------------------------- business facts
# Defaults are the café's published details; set a value here to override it,
# or "-" to hide it (e.g. BUSINESS_EMAIL=-).
BUSINESS_NAME=Ennie Coffee
BUSINESS_TAGLINE_NAME=Ennie Coffee Kávéház
BUSINESS_STREET_ADDRESS=Kossuth tér 10.
BUSINESS_POSTAL_CODE=3000
BUSINESS_CITY=Hatvan
BUSINESS_COUNTRY_CODE=HU
BUSINESS_PHONE=+36 37 950 875
BUSINESS_EMAIL=enniecoffee@yahoo.com
BUSINESS_FOUNDED_YEAR=2015
# schema.org format: Mo-Fr 09:30-19:00; Sa-Su 10:00-19:00
BUSINESS_OPENING_HOURS=Mo-Fr 09:30-19:00; Sa-Su 10:00-19:00
BUSINESS_GEO_LATITUDE=47.66630301
BUSINESS_GEO_LONGITUDE=19.6839051
# Optional overrides (https only):
# BUSINESS_DIRECTIONS_URL=
# BUSINESS_MAP_EMBED_URL=

# ----------------------------------------------------------------- legal (Impresszum, privacy notice)
# Not published by the café — fill these in before launch. Empty values are shown on the legal
# pages as "nincs megadva" and listed in the admin dashboard.
LEGAL_OPERATOR_NAME=
LEGAL_REGISTERED_ADDRESS=
LEGAL_REGISTRATION_NUMBER=
LEGAL_REGISTRY_AUTHORITY=
LEGAL_TAX_NUMBER=
LEGAL_REPRESENTATIVE=
# Default to BUSINESS_EMAIL / BUSINESS_PHONE when empty.
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_HOSTING_PROVIDER_NAME=
LEGAL_HOSTING_PROVIDER_ADDRESS=
LEGAL_HOSTING_PROVIDER_CONTACT=
# e.g. 2026. szeptember 23.
LEGAL_EFFECTIVE_DATE=
