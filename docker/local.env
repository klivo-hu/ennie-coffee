# LOCALHOST SWITCHES for docker-compose.local.yml and docker-compose.dev.yml. Loaded after .env,
# so these win: plain HTTP on localhost needs non-secure cookies, and the second factor is optional
# there. Secrets and the admin account come from .env — nothing secret belongs in this file.

SITE_URL=http://localhost:8080
AUTH_COOKIE_SECURE=false
ADMIN_MFA_REQUIRED=false
TRUSTED_PROXY_HOPS=0
