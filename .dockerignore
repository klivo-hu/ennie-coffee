# Never in the build context: secrets, local state, and VCS data.
.env
.env.*
!.env.example
.git
.github
node_modules
.next
out
coverage
*.log
*.tsbuildinfo

# The data store. Anything here is a local run's content — menu edits, sessions, uploaded
# imagery — and it belongs in a volume, never baked into an image that is served to the public.
data

# Tooling and documentation the image does not need.
.cef
.claude
docs
deploy
tests
Dockerfile
.dockerignore
# Compose files are not needed inside the image, and keeping them out means editing a stack never
# invalidates a production build layer.
docker-compose.yml
docker-compose.*.yml
docker
